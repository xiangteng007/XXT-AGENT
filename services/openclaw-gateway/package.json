{
  "name": "@xxt-agent/openclaw-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw Gateway — WebSocket + REST + Proxy + Local Runner Circuit Breaker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude='src/**/*.integration.test.ts'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config tests/e2e/vitest.e2e.config.ts",
    "pretest:e2e:real": "docker-compose -f docker-compose.e2e.yml up -d",
    "test:e2e:real": "cross-env E2E_REAL_DEPENDENCIES=true vitest run --config tests/e2e/vitest.e2e.config.ts",
    "posttest:e2e:real": "docker-compose -f docker-compose.e2e.yml down"
  },
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^2.4.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@xxt-agent/types": "file:../../packages/types",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.10",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.1"
  }
}
