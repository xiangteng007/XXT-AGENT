# ══════════════════════════════════════════════════════════════
# XXT-AGENT Dashboard — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env.local for local development
# For Vercel: Set these in Project Settings → Environment Variables

# ── Firebase / Auth ──────────────────────────────────────────
FIREBASE_PROJECT_ID=xxt-agent
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Cloud Run Service Gateway URLs (Server-side only) ────────
# These are used by Next.js API routes to proxy to Cloud Run services.
# They MUST be set in Vercel production env for the dashboard to work!
OPENCLAW_GATEWAY_URL=https://openclaw-gateway-257379536720.asia-east1.run.app
AI_GATEWAY_URL=https://ai-gateway-257379536720.asia-east1.run.app
CLOUD_FUNCTIONS_URL=https://asia-east1-xxt-agent.cloudfunctions.net

# ── Butler API ──────────────────────────────────────────────
BUTLER_API_URL=https://asia-east1-xxt-agent.cloudfunctions.net/butlerApi

# ── Cloud Run Health Check ──────────────────────────────────
CLOUD_RUN_PROJECT_HASH=257379536720
CLOUD_RUN_REGION=asia-east1

# ── Client-side env vars (prefixed with NEXT_PUBLIC_) ────────
NEXT_PUBLIC_CLOUD_RUN_PROJECT_HASH=257379536720
NEXT_PUBLIC_CLOUD_RUN_REGION=asia-east1
# NEXT_PUBLIC_API_BASE_URL=  # Leave empty for same-origin API calls
# NEXT_PUBLIC_BUTLER_API_URL=  # Override only if needed
# NEXT_PUBLIC_AI_GATEWAY_URL=  # Override only if needed
