# Firebase Functions �?環境變數範本
# SECURITY: Never commit real values - use Firebase Secret Manager for production
# cp .env.example .env.local  然後填入實際�?
# ── Telegram Bot ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── LINE Bot ───────────────────────────────────────────────
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# ── NAS Vector Memory (ChromaDB) ───────────────────────────
# NAS 本機 IP �?Tailscale URL
CHROMADB_URL=http://192.168.31.77:8001
CHROMADB_TOKEN=

# ── Local Inference (Ollama via Tailscale Funnel) ──────────
# Examples:
#   https://your-machine.tailnet-xxx.ts.net  (Tailscale)
#   http://192.168.1.100:11434               (LAN direct)
OLLAMA_BASE_URL=https://your-machine.tailnet-xxx.ts.net

# ── MPE Market Data ────────────────────────────────────────
FINMIND_API_TOKEN=

# ── Social Integrations ────────────────────────────────────
META_ACCESS_TOKEN=
THREADS_ACCESS_TOKEN=

# ── Garmin Integration ─────────────────────────────────────
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# ── Open Banking ───────────────────────────────────────────
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
